#!/usr/bin/env python3
from __future__ import annotations

import json
import re
import subprocess
import sys


def extract_json(text: str) -> dict:
    stripped = text.strip()
    if stripped.startswith("```"):
        stripped = re.sub(r"^```(?:json)?\s*", "", stripped)
        stripped = re.sub(r"\s*```$", "", stripped)
    try:
        return json.loads(stripped)
    except json.JSONDecodeError:
        match = re.search(r"\{.*\}", stripped, flags=re.S)
        if not match:
            raise
        return json.loads(match.group(0))


def main() -> int:
    request = json.load(sys.stdin)
    system_prompt = request["system_prompt"]
    payload = request["payload"]
    prompt = (
        f"{system_prompt}\n\n"
        "Do not call tools. Return only the strict JSON object, with no markdown.\n\n"
        "Payload:\n"
        f"{json.dumps(payload, ensure_ascii=False, indent=2)}"
    )
    completed = subprocess.run(
        ["hermes", "-z", prompt],
        capture_output=True,
        text=True,
        check=False,
        timeout=180,
    )
    if completed.returncode != 0:
        print(
            json.dumps(
                {
                    "decision": "needs_manual_review",
                    "confidence": "low",
                    "summary": "Hermes 模型复核命令执行失败，已保留确定性校验结果。",
                    "risks": [
                        {
                            "severity": "high",
                            "area": "model_review",
                            "reason": (completed.stderr or completed.stdout or f"exit code {completed.returncode}").strip(),
                            "suggested_check": "检查 Hermes 模型配置和网络状态后重新运行。",
                        }
                    ],
                    "next_action": "先人工复核 MusicXML 与 PDF，再决定是否进入练习分析。",
                },
                ensure_ascii=False,
            )
        )
        return 0
    print(json.dumps(extract_json(completed.stdout), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
