#!/usr/bin/env bash
set -euo pipefail

# Dynamically determine project root
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$PROJECT_ROOT"
export PYTHONPATH="$PROJECT_ROOT${PYTHONPATH:+:$PYTHONPATH}"
export PIANO_TEACHER_USE_HERMES_SUBAGENTS=1
PYTHON_BIN="${PYTHON_BIN:-/usr/local/opt/python@3.11/libexec/bin/python3}"
if [[ ! -x "$PYTHON_BIN" ]]; then
  PYTHON_BIN="python3"
fi
exec "$PYTHON_BIN" -m app.main ask "$*"
